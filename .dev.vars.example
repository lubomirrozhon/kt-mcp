# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.
KT_EMAIL="you@example.com"
KT_PASSWORD="your-kaloricketabulky-password"
# Typed on the consent page when connecting an agent. Make it long (min. 12 chars).
